            "content": "import { Link } from \"react-router\";\nimport { Mail, Phone, MapPin, Linkedin, Twitter, Facebook } from \"lucide-react\";\n\nexport function Footer() {\n  const currentYear = new Date().getFullYear();\n\n  return (\n    <footer className=\"bg-gray-900 text-gray-300\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12\">\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8\">\n          {/* Company Info */}\n          <div className=\"lg:col-span-2\">\n            <div className=\"flex items-center space-x-2 mb-4\">\n              <div className=\"w-9 h-9 bg-gradient-to-br from-[#002E6E] to-[#00B9F1] rounded-lg flex items-center justify-center\">\n                <span className=\"text-white font-bold text-lg\">N</span>\n              </div>\n              <span className=\"text-xl font-bold text-white\">OPENDRAP</span>\n            </div>\n            <p className=\"text-sm mb-4 max-w-sm\">\n              AI-powered business solutions that help companies automate, scale, and grow. Transform your business with cutting-edge technology.\n            </p>\n            <div className=\"flex space-x-4\">\n              <a href=\"#\" className=\"hover:text-white transition-colors\">\n                <Linkedin className=\"h-5 w-5\" />\n              </a>\n              <a href=\"#\" className=\"hover:text-white transition-colors\">\n                <Twitter className=\"h-5 w-5\" />\n              </a>\n              <a href=\"#\" className=\"hover:text-white transition-colors\">\n                <Facebook className=\"h-5 w-5\" />\n              </a>\n            </div>\n          </div>\n\n          {/* Products */}\n          <div>\n            <h3 className=\"text-white font-semibold mb-4\">Products</h3>\n            <ul className=\"space-y-2 text-sm\">\n              <li>\n                <Link to=\"/products/whatsapp-ai\" className=\"hover:text-white transition-colors\">\n                  Meta AI Agent\n                </Link>\n              </li>\n              <li>\n                <Link to=\"/products/voice-ai\" className=\"hover:text-white transition-colors\">\n                  AI Voice Calling\n                </Link>\n              </li>\n              <li>\n                <Link to=\"/products/chatbot\" className=\"hover:text-white transition-colors\">\n                  AI Chatbot\n                </Link>\n              </li>\n              <li>\n                <Link to=\"/products/automation\" className=\"hover:text-white transition-colors\">\n                  Business Automation\n                </Link>\n              </li>\n            </ul>\n          </div>\n\n          {/* Company */}\n          <div>\n            <h3 className=\"text-white font-semibold mb-4\">Company</h3>\n            <ul className=\"space-y-2 text-sm\">\n              <li>\n                <Link to=\"/\" className=\"hover:text-white transition-colors\">\n                  About Us\n                </Link>\n              </li>\n              <li>\n                <Link to=\"/products\" className=\"hover:text-white transition-colors\">\n                  Products\n                </Link>\n              </li>\n              <li>\n                <Link to=\"/contact\" className=\"hover:text-white transition-colors\">\n                  Contact\n                </Link>\n              </li>\n              <li>\n                <a href=\"#\" className=\"hover:text-white transition-colors\">\n                  \n                </a>\n              </li>\n            </ul>\n          </div>\n\n          {/* Contact */}\n          <div>\n            <h3 className=\"text-white font-semibold mb-4\">Contact</h3>\n            <ul className=\"space-y-3 text-sm\">\n              <li className=\"flex items-start space-x-2\">\n                <Mail className=\"h-4 w-4 mt-0.5 flex-shrink-0\" />\n                <span>opendrap@gmail.com</span>\n              </li>\n              <li className=\"flex items-start space-x-2\">\n                <Phone className=\"h-4 w-4 mt-0.5 flex-shrink-0\" />\n                <span>+91 8072620523</span>\n              </li>\n              <li className=\"flex items-start space-x-2\">\n                <MapPin className=\"h-4 w-4 mt-0.5 flex-shrink-0\" />\n                <span>chennai</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        {/* Bottom Bar */}\n        <div className=\"border-t border-gray-800 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center text-sm\">\n          <p>&copy; {currentYear} OPENDRAP. All rights reserved.</p>\n          <div className=\"flex space-x-6 mt-4 md:mt-0\">\n            <a href=\"#\" className=\"hover:text-white transition-colors\">\n              Privacy Policy\n            </a>\n            <a href=\"#\" className=\"hover:text-white transition-colors\">\n              Terms of Service\n            </a>\n            <a href=\"#\" className=\"hover:text-white transition-colors\">\n              Cookie Policy\n            </a>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n}"
